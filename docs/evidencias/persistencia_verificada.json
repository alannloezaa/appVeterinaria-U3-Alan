  "consulta": "SELECT id, mascota, cliente, servicio, DATE_FORMAT(fecha, '%Y-%m-%d') AS fecha, TIME_FORMAT(hora, '%H:%i') AS hora, estado, created_at, updated_at FROM citas ORDER BY id",
